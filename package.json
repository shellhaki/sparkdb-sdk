{
  "name": "@shellhaki/sparkdb-sdk",
  "version": "1.1.0",
  "description": "TypeScript SDK and ORM client for SparkDB.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
